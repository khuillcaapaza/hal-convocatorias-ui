# Cabeceras de seguridad para el panel de convocatorias (Next.js output: export).
# public/.htaccess -> Next lo copia a out/ y se despliega en la raíz del dominio.
# La API va bajo /api (mismo origen); las subidas van a hospitalantoniolorena.gob.pe/files-api.
# Requiere Apache + mod_headers.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

    # HSTS solo sobre HTTPS. Si ya lo defines en nginx/Hestia, deja una sola fuente.
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

    # CSP conservadora: API mismo origen (/api) + servicio de archivos (uploads/fetch)
    # en hospitalantoniolorena.gob.pe. 'unsafe-inline' por estilos inline de Next.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https://hospitalantoniolorena.gob.pe; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://hospitalantoniolorena.gob.pe; upgrade-insecure-requests"
</IfModule>
